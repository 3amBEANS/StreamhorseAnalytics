{
    "version": 2,
    "builds": [
      {
        "src": "streamhorse-analytics/package.json",
        "use": "@vercel/static-build",
        "config": {
            "distDir": "frontend/dist"
        }
      },
      {
        "src": "backend/server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/(.*)",
        "dest": "/backend/$1"
      },
      {
        "src": "/(.*)",
        "dest": "/streamhorse-analytics/$1"
      }
    ]
  }
  